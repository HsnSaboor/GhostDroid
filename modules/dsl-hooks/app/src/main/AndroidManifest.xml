<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeviceSpoofLab">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="com.devicespooflab.hooks.XposedService"
            android:exported="true" />

        <!-- Legacy discovery tags: Vector/LSPosed manager lists packages with
             xposedmodule=true. The daemon classifies modern vs legacy purely
             by APK contents (java_init.list present => modern). Do NOT add
             assets/xposed_init: that single file flips the module to legacy,
             kills the modern binder (SEND_BINDER), and VectorLegacyBridge
             then looks for a de.robv entry that does not exist. Modern path
             (XposedProvider/libxposed) stays primary. -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="GhostDroid S26 Ultra Framework Cloak" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
</application>

</manifest>
