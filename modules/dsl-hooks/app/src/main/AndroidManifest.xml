<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeviceSpoofLab">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="com.devicespooflab.hooks.XposedService"
            android:exported="true" />

        <!-- Legacy discovery tags for VectorLegacyBridge scanner (manager
             only lists packages with xposedmodule=true + assets/xposed_init).
             Modern path (XposedProvider/libxposed) stays primary. -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="GhostDroid S26 Ultra Framework Cloak" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
</application>

</manifest>
