// M3E DockedToolbar: bottom action bar (replaces BottomAppBar).
// Composes official M3 TextButton row + @children slot for SplitButton etc.
// Ref: `.devdocs/react-material-expressive/src/components/index.ts:200-206`.
import { TextButton } from "@material";
import { M3EColor } from "m3e_color.slint";

export component DockedToolbar {
    in property <[string]> actions;

    callback pressed(index: int);

    bar := Rectangle {
        background: M3EColor.surface-container;
        border-radius: 16px;
        min-height: 56px;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 2px;
            alignment: center;

            for a[i] in root.actions : TextButton {
                text: a;
                clicked => { root.pressed(i); }
            }

            @children
        }
    }
}
