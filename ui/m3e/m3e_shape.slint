// M3E shape: 10-step corner scale.
// Ref: `.devdocs/react-material-expressive/src/styles.css:81-90`.
export global M3EShape {
    out property <length> none: 0px;
    out property <length> xs: 4px;
    out property <length> s: 8px;
    out property <length> m: 12px;
    out property <length> l: 16px;
    out property <length> l-inc: 20px;
    out property <length> xl: 28px;
    out property <length> xl-inc: 32px;
    out property <length> xxl: 48px;
    out property <length> full: 9999px;
}
